// To get started, press Ctrl+Space to bring up the completion menu and view the available nodes.
&gpiote {
    status = "okay";
};
&i2c0 {
    status = "okay";
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";
    mydisplay: mydisplay@27 {
        compatible = "i2c-device";
        status = "okay";
        reg = <0x27>;
    };
};

&pinctrl {
    /omit-if-no-ref/ i2c0_default: i2c0_default {
        group1  {
            psels = <NRF_PSEL(TWIM_SCL, 1, 14)>,
                    <NRF_PSEL(TWIM_SDA, 1, 15)>;
        };
    };

    /omit-if-no-ref/ i2c0_sleep: i2c0_sleep {
        group1  {
            psels = <NRF_PSEL(TWIM_SCL, 1, 14)>,
                    <NRF_PSEL(TWIM_SDA, 1, 15)>;
            low-power-enable;
        };
    };
};

/{
    buzzers {
        compatible = "gpio-keys";  /* or just a logical container node */

        buzzer1: buzzer1 {
            gpios = <&gpio0 11 GPIO_ACTIVE_HIGH>;
        };
        buzzer2: buzzer2 {
            gpios = <&gpio0 12 GPIO_ACTIVE_HIGH>;
        };
        buzzer3: buzzer3 {
            gpios = <&gpio0 24 GPIO_ACTIVE_HIGH>;
        };
        buzzer4: buzzer4 {
            gpios = <&gpio0 25 GPIO_ACTIVE_HIGH>;
        };
    };
};